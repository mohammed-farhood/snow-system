// Snow factory — one sale model for ice and goods, stock computed from movements,
// debts settled with payments. Money is whole Iraqi dinars (Int): no fractions exist in practice.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  SUPERVISOR
  WORKER
}

enum ProductKind {
  ICE   // made here: stock comes from production
  GOODS // bought in: stock comes from purchases
}

enum ExpenseCategory {
  GAS
  ELECTRICITY
  WATER
  SALARY
  MAINTENANCE
  OTHER
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  pin       String // bcrypt hash of a 4–6 digit PIN
  role      Role     @default(WORKER)
  isActive  Boolean  @default(true)
  failedPin Int      @default(0)
  lockedTil DateTime?
  createdAt DateTime @default(now())

  sales       Sale[]
  productions Production[]
  expenses    Expense[]
  purchases   Purchase[]
  payments    Payment[]
}

model Product {
  id           Int         @id @default(autoincrement())
  name         String
  kind         ProductKind @default(GOODS)
  unit         String      @default("حبة")
  price        Int
  // ICE only: how many produced blocks one unit uses up (block = 1).
  blocksPerUnit Decimal    @default(1) @db.Decimal(6, 3)
  openingStock Int         @default(0)
  sortOrder    Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  phone     String?
  createdAt DateTime @default(now())

  sales    Sale[]
  payments Payment[]
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  phone     String?
  createdAt DateTime @default(now())

  purchases Purchase[]
  payments  Payment[]
}

model Sale {
  id          Int      @id @default(autoincrement())
  receiptNo   Int      @unique @default(autoincrement())
  date        DateTime @default(now())
  customerId  Int?
  total       Int
  paid        Int
  note        String?
  createdById Int

  customer  Customer?  @relation(fields: [customerId], references: [id])
  createdBy User       @relation(fields: [createdById], references: [id])
  items     SaleItem[]

  @@index([date])
}

model SaleItem {
  id        Int @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Int
  price     Int

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Production {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  blocks      Int
  wasted      Int      @default(0)
  note        String?
  createdById Int

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([date])
}

model Purchase {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  supplierId  Int
  total       Int
  paid        Int
  note        String?
  createdById Int

  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  items     PurchaseItem[]

  @@index([date])
}

model PurchaseItem {
  id         Int @id @default(autoincrement())
  purchaseId Int
  productId  Int
  quantity   Int
  cost       Int

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}

// Money settling an old debt: from a customer (in) or to a supplier (out).
model Payment {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  customerId  Int?
  supplierId  Int?
  amount      Int
  note        String?
  createdById Int

  customer  Customer? @relation(fields: [customerId], references: [id])
  supplier  Supplier? @relation(fields: [supplierId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([date])
}

model Expense {
  id          Int             @id @default(autoincrement())
  date        DateTime        @default(now())
  category    ExpenseCategory
  amount      Int
  note        String?
  createdById Int

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([date])
}

model Setting {
  key   String @id
  value String
}
